RewriteEngine On

# Leave API requests, real files, directories, and missing static resources untouched.
RewriteRule ^api/ - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} \.(?:css|js|mjs|map|png|jpe?g|webp|gif|svg|ico|txt|xml|json|woff2?)$ [NC]
RewriteRule ^ - [L]

# Serve the React entry point for client-side website routes.
RewriteRule ^ index.html [L]
